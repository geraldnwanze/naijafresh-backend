APP_NAME=NaijaFresh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL of the Next.js storefront. Used for CORS and Paystack redirect callbacks.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=10

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=naijafresh
DB_USERNAME=naijafresh
DB_PASSWORD=naijafresh

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Emails are always queued. `composer run dev` starts a worker locally; in production run `php artisan queue:work` (use database/redis).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit (docker compose up -d) shows sent emails at http://localhost:8025. Use a real provider in production.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@naijafresh.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / API auth ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# --- NaijaFresh business config (safe defaults; override per environment) ---
NAIJAFRESH_CURRENCY=NGN
# Default flat delivery fee in kobo (₦2,000). Overridable at runtime via admin settings.
NAIJAFRESH_DELIVERY_FEE=200000
# Free delivery threshold in kobo (0 = disabled).
NAIJAFRESH_FREE_DELIVERY_THRESHOLD=0
NAIJAFRESH_ENABLE_CASH_ON_DELIVERY=true
NAIJAFRESH_ENABLE_BANK_TRANSFER=true

# --- First-run setup (production) ---
# On boot the container runs `php artisan naijafresh:setup`, which creates this super admin
# if none exists yet (12+ character password in production). Remove the password afterwards.
SUPER_ADMIN_NAME="NaijaFresh Owner"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- Payments ---
# Provider: "paystack" when keys are present, otherwise "mock" for a fully testable checkout.
PAYMENT_PROVIDER=mock
# The mock gateway is refused in production unless this is true (it marks orders paid for free).
NAIJAFRESH_ALLOW_MOCK_PAYMENTS=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Exposed to the browser by the frontend; kept here for reference/parity.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

